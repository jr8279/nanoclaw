{
  "name": "nanoclaw-todo",
  "version": "1.0.0",
  "description": "Self-hosted todo app for NanoClaw — categories, due dates, importance, recurrence, notes/links, PWA UI, REST API for the nanoclaw agent MCP tool.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev:api": "node --watch src/server.js",
    "dev:web": "vite",
    "build": "vite build",
    "test": "node --test \"test/**/*.test.js\"",
    "test:web": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@simplewebauthn/server": "^14.0.1",
    "better-sqlite3": "^11.3.0",
    "express": "^4.21.2",
    "framer-motion": "13.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "^30.0.1",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
